<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ayah_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/muslingo_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/ayah_widget_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Аят дня"
        android:textColor="#1B557B"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ayah_widget_arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:text="آية اليوم"
        android:textColor="#173B55"
        android:textDirection="rtl"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/ayah_widget_translation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Открой Muslingo"
        android:textColor="#536E7F"
        android:textSize="12sp" />
</LinearLayout>
